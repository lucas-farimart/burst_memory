# SimVision Command Script (Wed Oct 21 15:34:27 -03 2026)
#
# Version 23.09.s003
#
# You can restore this configuration with:
#
#     simvision -input burst-mult.svcf
#  or simvision -input burst-mult.svcf database1 database2 ...
#


#
# Preferences
#
preferences set toolbar-Standard-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-txe_waveform_navigate-WaveWindow {
  usual
  shown 1
  position -row 3
}
preferences set expand-attributes begin_time
preferences set plugin-enable-svdatabrowser-new 1
preferences set toolbar-Windows-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-Search-Console {
  usual
  position -anchor e
}
preferences set toolbar-txe_waveform_toggle-WaveWindow {
  usual
  position -pos 1
}
preferences set plugin-enable-groupscope 0
preferences set toolbar-txe_waveform_view-WaveWindow {
  usual
  shown 1
  position -row 3
}
preferences set standard-methodology-filtering 1
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0
preferences set toolbar-SimControl-WatchWindow {
  usual
  shown 0
}
preferences set toolbar-Windows-WaveWindow {
  usual
  position -pos 2
}
preferences set toolbar-WaveZoom-WaveWindow {
  usual
  position -anchor w
}
preferences set toolbar-TimeSearch-WatchWindow {
  usual
  shown 0
}

#
# PPE data
#
array set dbNames ""
set dbNames(realName1) [database require waves  -hints {
	file ./waves.shm/waves.trn
	file /home/lucas.martins/workspace/burst_memory/waves.shm/waves.trn
}]
#
# Groups
#
catch {group new -name MEM-A -overlay 0}
catch {group new -name MEM-B -overlay 0}
group using MEM-A
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.req[4:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.valid[4:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.addr[8:0]}]} ]
group using MEM-B
group set -overlay 0
group set -comment {}
group clear 0 end

group insert \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.req[4:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.valid[4:0]}]} ] \
    [subst  {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.addr[8:0]}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1920x1016+-1+26}] != ""} {
    window geometry "Waveform 1" 1920x1016+-1+26
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 189 \
    -units ps \
    -valuewidth 103
waveform baseline set -time 0

set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.clk}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.rstn}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.enb_a}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.enb_b}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.size_a[3:0]}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.size_b[3:0]}]}
	} ]]
waveform format $id -color #ffffff
set id [waveform add -cdivider divider]
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.mult_vld_i}]}
	} ]]
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.mult_vld_o}]}
	} ]]
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.rdata_a[7:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.rdata_b[7:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{$dbNames(realName1)::[format {tb_memory_mult.mult_o[15:0]}]}
	} ]]
set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups MEM-A]
waveform format $groupId0 -namecolor #00ffff
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.req[4:0]}]} {-color #00ffff -namecolor #00ffff}
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.valid[4:0]}]} {-color #00ffff -namecolor #00ffff}
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_a.addr[8:0]}]} {-color #00ffff -namecolor #00ffff}
}] childcmds {
    {}
    {
        set id $gpID0
        waveform hierarchy collapse $id
    }
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}

set id [waveform add -cdivider divider]

set groupId0 [waveform add -groups MEM-B]
waveform format $groupId0 -namecolor #00ff99
set gpGlist0 [waveform hierarchy contents $groupId0]
set gpID0 [lindex $gpGlist0 0]
foreach {name attrs} [subst  {
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.req[4:0]}]} {-color #00ff99 -namecolor #00ff99}
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.valid[4:0]}]} {-color #00ff99 -namecolor #00ff99}
    {$dbNames(realName1)::[format {tb_memory_mult.mem_ctrl_b.addr[8:0]}]} {-color #00ff99 -namecolor #00ff99}
}] childcmds {
    {}
    {}
    {}
} {
    set expected [ join [waveform signals -format fullpath $gpID0] ]
    if {[string equal $name $expected] || $name == "cdivider"} {
        if {$attrs != ""} {
            eval waveform format $gpID0 $attrs
        }
        if { $childcmds != ""} {
            eval $childcmds
        }
    }
    set gpGlist0 [lrange $gpGlist0 1 end]
    set gpID0 [lindex $gpGlist0 0]
}


waveform xview limits 0 104664ps

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 960x1043+1910+-8

